{
  "name": "koda-client-project-tracker",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run && vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "db:push": "npx prisma db push --accept-data-loss",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx prisma db push --force-reset --accept-data-loss && npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "^1.0.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
